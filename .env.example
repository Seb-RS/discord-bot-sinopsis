# Obligatorio
DISCORD_TOKEN=
# https://www.themoviedb.org/settings/api  (vale la API key v3 o el Read Access Token v4)
TMDB_API_KEY=

# Opcional: añade IMDb (y Metascore de respaldo). Gratis: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Opcional: ID de tu servidor para que el comando aparezca al instante mientras pruebas
DEV_GUILD_ID=

# FilmAffinity está tras Cloudflare y bloquea clientes que no son navegador.
# Ponlo a 1 solo si compruebas que desde tu VPS responde.
ENABLE_FILMAFFINITY=0

# Voz: si quien usa /pelicula está en un canal de voz, el bot entra y lee título y sinopsis.
# Necesita FFmpeg instalado. Voces: es-MX-DaliaNeural, es-MX-JorgeNeural, es-AR-ElenaNeural,
# es-AR-TomasNeural, es-ES-ElviraNeural… (lista: .venv/bin/edge-tts --list-voices)
ENABLE_VOICE=1
TTS_VOICE=es-MX-DaliaNeural
# Ruta a ffmpeg si no está en el PATH
FFMPEG_PATH=

LOG_LEVEL=INFO
