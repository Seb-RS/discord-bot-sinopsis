# /etc/systemd/system/sinopsis-bot.service
[Unit]
Description=Bot de Discord de sinopsis y valoraciones
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sinopsis
WorkingDirectory=/opt/sinopsis-bot
ExecStart=/opt/sinopsis-bot/.venv/bin/python -OO bot.py
Restart=on-failure
RestartSec=10
# Convivencia con otros servicios del VPS:
# techo de memoria (si se dispara, systemd lo mata y reinicia en vez de ahogar el VPS),
# máximo medio núcleo de CPU y prioridad baja de CPU y disco (cede ante el resto).
# (los 200M incluyen FFmpeg mientras lee en voz)
MemoryMax=200M
CPUQuota=50%
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
